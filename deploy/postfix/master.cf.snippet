# Postfix master.cf pipe service definition for AMail
# Append to /etc/postfix/master.cf

amail_pipe unix  -       n       n       -       2       pipe
  flags=XDRhu user=amail:amail argv=/opt/amail/venv/bin/python3 /opt/amail/scripts/ingest_mail.py --sender=${sender} --recipient=${recipient} --size=${size} --db-path=/opt/amail/db.sqlite3
