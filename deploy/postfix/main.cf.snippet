# Postfix configuration additions for AMail on viomet.online
# Append or merge these directives into /etc/postfix/main.cf

# Basic identification
myhostname = mail.viomet.online
mydomain = viomet.online
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4

# Important: viomet.online must NOT be in mydestination when using virtual domains
mydestination = localhost.$mydomain, localhost

# SQLite Virtual Domain and Mailbox recipient lookups
virtual_mailbox_domains = sqlite:/etc/postfix/sqlite-virtual-domains.cf
virtual_mailbox_maps = sqlite:/etc/postfix/sqlite-virtual-mailboxes.cf
virtual_transport = amail_pipe

# Reject unlisted recipients at SMTP boundary (Anti-Backscatter & Spam protection)
smtpd_reject_unlisted_recipient = yes

# SMTP Relay Restrictions - Anti Open-Relay
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

# SMTP Recipient Restrictions
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination,
    reject_unlisted_recipient,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain

# Maximum Message Size: 5MB (5242880 bytes) - optimized for 1GB VPS
message_size_limit = 5242880
mailbox_size_limit = 0

# Concurrency limits for 1GB RAM VPS
amail_pipe_destination_concurrency_limit = 2
amail_pipe_destination_recipient_limit = 1
default_process_limit = 50

# TLS Configuration (Let's Encrypt certificates)
smtpd_tls_security_level = may
smtpd_tls_cert_file = /etc/letsencrypt/live/mail.viomet.online/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/mail.viomet.online/privkey.pem
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_ciphers = high
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtpd_tls_received_header = yes
