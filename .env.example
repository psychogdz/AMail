# ==========================================
# AMail — Environment Variables Configuration
# ==========================================

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.production

# Secret key (Generate a secure 50+ character random string for production)
# python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Debug Mode (Must be False in production)
DEBUG=False

# Allowed Hostnames (Comma-separated)
ALLOWED_HOSTS=amail.viomet.online,localhost,127.0.0.1

# Site URL for CSRF and links
SITE_URL=https://amail.viomet.online

# Main email domain for disposable addresses
EMAIL_DOMAIN=viomet.online

# Email retention policy (Days to keep emails before auto-cleanup)
EMAIL_RETENTION_DAYS=30

# Maximum incoming email size in Megabytes
MAX_EMAIL_SIZE_MB=5

# HTTPS & Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
